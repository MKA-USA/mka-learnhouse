# Local dev Postgres (docker compose up -d db)
# Generate once: openssl rand -hex 16
COMPLIANCE_DB_PASSWORD=
# Optional override; default is built from COMPLIANCE_DB_PASSWORD (loopback only).
# DATABASE_URL=postgres://compliance:<password>@127.0.0.1:5433/compliance

# LearnHouse STAGING only. Never point at production.
LH_API_BASE=https://ilm-dev.mkausa.org/api/v1
LH_ORG_SLUG=
# Do NOT put the token here. Use scripts/with-lh-token.sh (macOS keychain item MKA_LH_DEV_API_TOKEN).
# LH_API_TOKEN=
