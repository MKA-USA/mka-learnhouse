{
  "name": "@mka/provisioner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "probe": "../../scripts/with-lh-token.sh bun run src/probe.ts",
    "start": "bun --env-file=../../.env run src/cli.ts",
