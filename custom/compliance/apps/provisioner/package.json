    "write-probe": "../../scripts/with-lh-token.sh bun run src/write-probe.ts --confirm-staging"
  },
  "dependencies": { "@mka/compliance-core": "workspace:*" },
  "devDependencies": { "typescript": "^5.6.0", "@types/bun": "latest" }
}
