# Dev: fixtures + persona switcher, no Google needed.
DASHBOARD_FIXTURE_MODE=1
# Fixture "today" (the demo cycle is 2026-27, Nov 1 -> Dec 1)
DASHBOARD_AS_OF=2026-11-18

# Real auth (production). Google OAuth restricted to this domain.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=mkausa.org
# Comma separated emails that see everything (also settable via the dashboard_access_override table)
DASHBOARD_ADMIN_EMAILS=

# Fork attribute API (admin token). Path is configurable until the endpoint is final.
LH_API_BASE=https://ilm-dev.mkausa.org/api/v1
ATTRIBUTES_LIST_PATH=/mka/attributes/admin/list
# LH_API_TOKEN comes from the environment/secret store, never from a file.
DATABASE_URL=
CYCLE_LABEL=2026-27
